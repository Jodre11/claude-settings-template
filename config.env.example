# Claude Settings Template — Configuration
# Copy to config.env and fill in your values.
# Run ./hydrate.sh to generate config files from templates.

# --- aws sso ---
# Lands in settings.work.json (work sessions only) and scripts/_aws-sso-common.sh. ~/.claudeenv exports the same
# profile for bare and nested claude calls, so it must match BEDROCK_AWS_PROFILE in the dotfiles config.env.
AWS_PROFILE=               # e.g. claude-code
SSO_START_URL=             # e.g. https://myorg.awsapps.com/start

# --- settings.json ---
# Leave blank: setup-platform.sh overwrites awsAuthRefresh with this platform's aws-sso-refresh.sh command.
AWS_SSO_REFRESH_PATH=

# --- settings.work.json (passed by the dotfiles claude() wrapper with --settings) ---
# The Bedrock inference-profile ARN modelOverrides maps the full Opus model ID to. Leave it empty to omit it.
MODEL_OVERRIDE_OPUS_5_5=

# --- datadog ---
DATADOG_SITE=              # e.g. datadoghq.com, datadoghq.eu
DATADOG_EXAMPLE_SERVICE=   # e.g. my-api-service

# --- CLAUDE.md ---
DOTFILES_REPO_URL=         # e.g. https://github.com/youruser/dotfiles

# --- web-search (SearXNG) ---
# Base URL of your SearXNG instance (required by the web-search plugin), e.g. http://localhost:8888
SEARXNG_URL=
