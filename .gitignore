# Private config (tracked in private repo, not in template)
config.env

# Machine-local pattern lists the git hooks read; they name what must not be published, so they are never committed
/.githooks/identity-patterns.local
/.githooks/always-patterns.local

# Generated files (produced by hydrate.sh from .tmpl templates)
settings.json
# The work settings layer, generated by hydrate.sh from the tracked settings.work.json.tmpl. Never tracked.
/settings.work.json
/CLAUDE.md
scripts/_aws-sso-common.sh
skills/datadog-log-link/SKILL.md
# A temp file hydrate.sh left behind (it removes them on every exit it sees; SIGKILL or power loss can leave one).
.*.hydrate.*

# Per-machine settings (written by scripts/setup-platform.sh)
settings.local.json
**/settings.local.json

# Ephemeral session data
history.jsonl
sessions/
session-env/
shell-snapshots/
debug/
paste-cache/
file-history/
backups/
plans/
todos/
tasks/
downloads/
ide/
cache/

# Plugin runtime data (not authored config)
plugins/

# MCP auth state
mcp-needs-auth-cache.json

# Telemetry and stats
statsig/
stats-cache.json
# Local API-error telemetry: track the collector config, ignore its runtime output.
telemetry/*.jsonl
telemetry/otelcol.log

# Local binaries (platform-specific, installed per machine — e.g. otelcol-contrib)
bin/

# Per-session security warnings
security_warnings_state_*.json

# Secret-firewall breach ledger, and code-review-suite runtime logs (both can name repos and people)
/breach-ledger.log
/code-review-suite/

# Session transcripts, tool results, and indexes inside projects
projects/*/*.jsonl
projects/*/sessions-index.json
projects/**/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*/
projects/*/.session-aliases

# Claude Code's per-project memory names real organisations, repositories and people, and the git hooks exempt it from
# the identity scan. To version it in a PRIVATE repository, uncomment the opt-in line; never in a public one.
projects/*/memory/
# !projects/*/memory/

# Cached images
image-cache/

# Agent team runtime state
teams/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
