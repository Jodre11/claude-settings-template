#!/bin/bash
# md2clip - Convert Markdown to rich-text HTML and copy to macOS clipboard.
# Usage: md2clip [--outlook] [--debug] <file.md>
#        echo "**bold**" | md2clip
#
# Default target is Teams, whose sanitiser drops <p> margins and auto-borders
# tables. --outlook inverts both: Outlook honours <p> spacing, so the paragraphs
# are kept rather than flattened to blank lines, and tables need explicit borders
# or they paste without gridlines.
#
# Requires: pandoc (brew install pandoc)
# Source:   claude-code-plugins/plugins/md-to-clipboard/tools/md2clip
# Symlink:  ln -sf <plugin-install-path>/tools/md2clip ~/.local/bin/md2clip

set -euo pipefail

debug=false
mode=teams
while [ $# -gt 0 ]; do
    case "${1:-}" in
        --debug)   debug=true; shift ;;
        --outlook) mode=outlook; shift ;;
        *)         break ;;
    esac
done

# --- Input -------------------------------------------------------------------

tmp_file="$(mktemp /tmp/md2clip-XXXXXX.md)"
trap 'rm -f "$tmp_file"' EXIT

if [ $# -ge 1 ] && [ -f "$1" ]; then
    cp "$1" "$tmp_file"
else
    cat > "$tmp_file"
fi

md_file="$tmp_file"

# --- Sanitise Markdown --------------------------------------------------------

# Teams renders these inconsistently across its clients, so flatten to ASCII.
# Outlook renders them correctly, and keeping them preserves the typography.
if [ "$mode" = teams ]; then
    # Replace em dashes (U+2014) with hyphens
    sed -i '' $'s/\xe2\x80\x94/-/g' "$md_file"

    # Replace smart quotes: U+2018, U+2019 -> ', U+201C, U+201D -> "
    sed -i '' $'s/\xe2\x80\x98/\'/g' "$md_file"
    sed -i '' $'s/\xe2\x80\x99/\'/g' "$md_file"
    sed -i '' $'s/\xe2\x80\x9c/"/g' "$md_file"
    sed -i '' $'s/\xe2\x80\x9d/"/g' "$md_file"
fi

# --- Convert to HTML ----------------------------------------------------------

html=$(pandoc "$md_file" -f markdown -t html --ascii --wrap=none)

# --- Post-process HTML for Teams ----------------------------------------------

# 1. Replace non-breaking spaces pandoc inserts after abbreviations
html=$(echo "$html" | sed 's/&#xA0;/ /g')

# 2. Replace smart curly quotes (single + double, both directions) with ASCII
if [ "$mode" = teams ]; then
    html=$(echo "$html" | sed "s/&#x2018;/'/g; s/&#x2019;/'/g; s/&#x201C;/\"/g; s/&#x201D;/\"/g")
fi

# 3. Join lines within <p> blocks (pandoc wraps long lines; Teams renders them
#    as line breaks, splitting sentences mid-flow)
html=$(echo "$html" | awk '
    /<p>/ { in_p=1 }
    in_p && /<\/p>/ {
        in_p=0
        buf = buf " " $0
        gsub(/  +/, " ", buf)
        print buf
        buf=""
        next
    }
    in_p {
        if (buf == "") { buf = $0 } else { buf = buf " " $0 }
        next
    }
    { print }
')

# 4/5. Teams ignores <p> margins, so the paragraphs are flattened and the spacing
# is rebuilt with blank lines. Outlook honours them -- doing this there would
# collapse every paragraph gap into one, so both steps are skipped.
if [ "$mode" = teams ]; then
    # 4. Strip <p> and </p> tags, then trim leading/trailing whitespace per line
    html=$(echo "$html" | sed 's/<p>//g; s/<\/p>//g; s/^[[:space:]]*//; s/[[:space:]]*$//')

    # 5. Insert blank line between content paragraphs for spacing
    html=$(echo "$html" | awk '
        NR==1 { print; prev=$0; next }
        {
            # Insert blank line between content lines, but not before/after block elements
            if (prev != "" && $0 != "" &&
                prev !~ /^<(ul|ol|\/ul|\/ol|table|\/table|thead|\/thead|tbody|\/tbody|tr|\/tr|th|\/th|td|\/td|li|\/li|h[1-6]|\/h[1-6]|blockquote|\/blockquote)/ &&
                $0 !~ /^<(ul|ol|\/ul|\/ol|table|\/table|thead|\/thead|tbody|\/tbody|tr|\/tr|th|\/th|td|\/td|li|\/li|h[1-6]|\/h[1-6]|blockquote|\/blockquote)/)
                print ""
            print
            prev=$0
        }
    ')
fi

# 6. Replace pandoc code block wrappers with plain <code>
html=$(echo "$html" | sed '
    s/<div class="sourceCode"[^>]*>//g
    s/<\/div>//g
    s/<pre[^>]*><code[^>]*>/<code>/g
    s/<\/code><\/pre>/<\/code>/g
')

# 7. Remove <br> immediately before <ul>/<ol> and after </ul>/<ol>
html=$(echo "$html" | sed '
    s/<br>[[:space:]]*<ul>/<ul>/g
    s/<br>[[:space:]]*<ol>/<ol>/g
    s/<\/ul>[[:space:]]*<br>/<\/ul>/g
    s/<\/ol>[[:space:]]*<br>/<\/ol>/g
')

# 8. Outlook draws no gridlines on an unstyled <table>, unlike Teams. Word's
#    rendering engine honours the legacy border/cellpadding attributes most
#    reliably. Two forms to cover: pandoc emits a bare <table> for simple tables
#    but <table style="width:..."> once it computes column widths, so matching
#    only the bare form silently misses every wide table.
if [ "$mode" = outlook ]; then
    html=$(echo "$html" | sed 's/<table style="/<table border="1" cellspacing="0" cellpadding="4" style="border-collapse:collapse;/g')
    html=$(echo "$html" | sed 's/<table>/<table border="1" cellspacing="0" cellpadding="4" style="border-collapse:collapse;">/g')

    # 8a. Drop pandoc's <colgroup>. For a pipe table it infers relative widths from
    #     the SOURCE column widths, which bear no relation to rendered content -- a
    #     7-column table comes out 7x14%, squashing short headings onto several lines
    #     while a long prose column stays cramped. Without it Outlook autosizes to
    #     content, which is what you want in every case seen so far.
    html=$(echo "$html" | sed '/<colgroup>/,/<\/colgroup>/d')
fi

# --- Output -------------------------------------------------------------------

if [ "$debug" = true ]; then
    echo "$html"
else
    echo "$html" | osascript -l JavaScript -e '
ObjC.import("AppKit");
var input = $.NSFileHandle.fileHandleWithStandardInput;
var data = input.readDataToEndOfFile;
var html = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
var pb = $.NSPasteboard.generalPasteboard;
pb.clearContents;
pb.setStringForType($(html), $.NSPasteboardTypeHTML);
""
'
    >&2 echo "Rich text copied to clipboard."
fi
