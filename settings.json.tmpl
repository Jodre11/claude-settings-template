{
  "awsAuthRefresh": "__AWS_SSO_REFRESH_PATH__",
  "env": {
    "API_TIMEOUT_MS": "1200000",
    "AWS_PROFILE": "__AWS_PROFILE__",
    "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "SEARXNG_URL": "__SEARXNG_URL__"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(playwright-cli *)",
      "Bash(jb *)",
      "Bash(ruff *)",
      "Bash(nbqa *)",
      "Bash(trivy *)",
      "Bash(eslint *)",
      "Bash(biome *)",
      "Bash(housekeeper-freshness *)",
      "Bash(*/node_modules/.bin/eslint *)",
      "Bash(*/node_modules/.bin/biome *)",
      "Bash(terraform fmt *)",
      "Bash(mktemp -d /tmp/claude-*)",
      "Edit(//tmp/claude-**)",
      "Read",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(brew info *)",
      "Bash(whisper-cli *)",
      "Bash(dotnet build *)",
      "Bash(dotnet add *)",
      "Bash(dotnet run *)",
      "Bash(dotnet list *)",
      "Bash(dotnet nuget *)",
      "Bash(dotnet package *)",
      "Bash(cargo init *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(jq *)",
      "Bash(command claude *)",
      "Bash(~/.claude/scripts/set-session-topic.sh *)",
      "Bash(~/.claude/scripts/handover-path.sh *)",
      "Bash(bash ~/.claude/scripts/handover-path.sh)",
      "Bash(chmod +x ~/.claude/hooks/*)",
      "Bash(chmod +x ~/.claude/scripts/*)",
      "Bash(python3 -m *)",
      "Bash(tmux *)",
      "Bash(aws sso *)",
      "Bash(aws sts *)",
      "Bash(aws s3 ls *)",
      "Bash(aws s3 cp *)",
      "Bash(aws bedrock-runtime *)",
      "Bash(md2clip *)",
      "Bash(xxd *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(file *)",
      "Bash(open *)",
      "Bash(printf *)"
    ],
    "ask": [
      "Bash(git *push *--force*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push * +*)",
      "Bash(git *push *--delete*)",
      "Bash(git *push -d *)",
      "Bash(git *push * -d *)",
      "Bash(git *push * :**)",
      "Bash(git *push *--mirror*)",
      "Bash(git *push *--prune*)",
      "Bash(git *reset *--hard*)",
      "Bash(git *clean -*f*)",
      "Bash(git *clean * -*f*)",
      "Bash(git *branch -D*)",
      "Bash(git *branch * -D*)",
      "Bash(git *branch -f*)",
      "Bash(git *branch * -f*)",
      "Bash(git *branch *--force*)",
      "Bash(git *filter-repo*)",
      "Bash(git *filter-branch*)",
      "Bash(git *--no-verify*)",
      "Bash(git *commit -n*)",
      "Bash(git *commit * -n*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Bash(git *--no-gpg-sign*)",
      "Bash(git *gpgsign=*)",
      "Bash(git *gpgSign=*)",
      "Bash(git *gpgsign * *)",
      "Bash(git *gpgSign * *)",
      "Bash(git *unset*gpgsign*)",
      "Bash(git *unset*gpgSign*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close *--delete-branch*)",
      "Bash(gh pr close -d*)",
      "Bash(gh pr close * -d*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh cache delete*)",
      "Bash(gh codespace delete*)",
      "Bash(gh gist delete*)",
      "Bash(gh gpg-key delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh project delete*)",
      "Bash(gh project field-delete*)",
      "Bash(gh project item-delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo deploy-key delete*)",
      "Bash(gh repo autolink delete*)",
      "Bash(gh run delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh variable delete*)",
      "Bash(gh repo create *--public*)",
      "Bash(gh gist create*)",
      "Bash(gh release create*)",
      "Bash(gh release upload*)",
      "Bash(gh release edit*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh repo sync *--force*)",
      "Bash(gh secret set*)",
      "Bash(gh repo deploy-key add*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *pulls/*/merge)",
      "Bash(gh api *pulls/*/merge *)",
      "Bash(gh api *pulls/*/merge\"*)",
      "Bash(gh api *pulls/*/merge'*)",
      "Bash(gh api *pulls/*/merge?*)",
      "Bash(gh api *pulls/*/merge#*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *AutoMerge*)",
      "Bash(gh api *visibility=*)",
      "Bash(aws * delete*)",
      "Bash(aws * terminate*)",
      "Bash(aws *s3 rm*)",
      "Bash(aws *s3 rb*)",
      "Bash(aws *s3 mv*)",
      "Bash(aws *s3 *--delete*)",
      "Bash(aws *s3 cp * s3://*)",
      "Bash(dotnet nuget push*)",
      "Bash(dotnet nuget delete*)",
      "Bash(tmux kill-*)",
      "Bash(tmux * kill-*)",
      "Bash(tmux *kill-server*)",
      "Bash(tmux *kill-session*)",
      "Bash(tmux *kill-window*)",
      "Bash(tmux *kill-pane*)",
      "Bash(command claude *dangerously-skip-permissions*)",
      "Bash(command claude *bypassPermissions*)",
      "Bash(command claude *disableAllHooks*)",
      "Bash(command claude *--setting-sources*)",
      "Bash(command claude *--settings*)",
      "Bash(command claude *--allowedTools*)",
      "Bash(command claude *--allowed-tools*)",
      "Bash(command claude *--permission-prompt-tool*)"
    ],
    "deny": [
      "Read(**/secrets/**)",
      "Read(**/.strongbox-keyid)",
      "Read(~/.strongbox_keyring)",
      "Edit(~/.strongbox_keyring)",
      "Read(**/*.secret)",
      "Bash(cat **/secrets/**)",
      "Bash(strings **/secrets/**)",
      "Bash(xxd **/secrets/**)",
      "Bash(*strongbox_keyring*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.sh",
            "timeout": 5,
            "statusMessage": "Initialising session..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handover-detect.sh",
            "timeout": 5,
            "statusMessage": "Checking for handover..."
          },
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_TOPIC_GUESS\" ] && [ -n \"$TMUX\" ] && [ -z \"$CLAUDE_CODE_USE_BEDROCK\" ] && tmux set status-style bg=colour218,fg=black; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-topic.sh",
            "timeout": 5,
            "statusMessage": "Guessing session topic..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-topic-provisional.sh",
            "timeout": 5,
            "statusMessage": "Setting provisional topic..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-prompt-guard.sh",
            "timeout": 5,
            "statusMessage": "Screening prompt for secrets..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_TOPIC_GUESS\" ] && [ -n \"$TMUX\" ] && tmux set -u status-style; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reviewer-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking reviewer read-only rule..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking Bash rules..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-bash-guard.sh",
            "timeout": 5,
            "statusMessage": "Screening for secrets..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-signing-ask.sh",
            "timeout": 5,
            "statusMessage": "Checking git signing..."
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-path-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking secret paths..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/settings-edit-ask.sh",
            "timeout": 5,
            "statusMessage": "Checking for a settings.json edit..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/temp-path-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking temp path..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmpl-output-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for hydrated outputs..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-output-scrubber.sh",
            "timeout": 5,
            "statusMessage": "Scrubbing tool output for secrets..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/api-failure-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-output-scrubber.sh",
            "timeout": 5,
            "statusMessage": "Scanning failed tool output for secrets..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": false,
    "roslyn-lsp@jodre11-plugins": true,
    "claude-security@claude-plugins-official": true
  },
  "language": "English UK",
  "spellcheck": {
    "enabled": true,
    "language": "en_GB"
  },
  "effortLevel": "xhigh",
  "showThinkingSummaries": true,
  "teammateMode": "in-process",
  "__remove__": {
    "keys": [
      ["sandbox", "allowedDomains"]
    ],
    "entries": {
      "permissions.allow": [
        "Bash(read-only commands)",
        "Bash(mkdir -p /tmp/claude-*)",
        "Bash(rm /tmp/claude-*)",
        "Bash(rm -f /tmp/claude-*)",
        "Bash(rm -rf /tmp/claude-*)",
        "Bash(cat /tmp/claude-*)",
        "Bash(cat * > /tmp/claude-*)",
        "Read(~/.claude/commands/**)",
        "Read(~/.claude/skills/**)",
        "Read(~/.claude/agents/**)",
        "Read(~/.claude/plugins/**)",
        "Bash(python3 *.py)",
        "Bash(aws secretsmanager get-secret-value *)",
        "Bash(aws ecr get-login-password *)",
        "Bash(curl -fsSL *)",
        "Bash(curl -s *)",
        "Bash(curl -sS *)",
        "Bash(jb:*)",
        "Bash(ruff:*)",
        "Bash(nbqa:*)",
        "Bash(trivy:*)",
        "Bash(eslint:*)",
        "Bash(biome:*)",
        "Bash(housekeeper-freshness:*)",
        "Bash(~/.claude/scripts/set-session-topic.sh:*)",
        "Bash(~/.claude/scripts/handover-path.sh:*)",
        "Bash(find *)",
        "Bash(cp *)",
        "Bash(curl *)",
        "Write(//tmp/claude-**)"
      ],
      "permissions.ask": [
        "Bash(git *gpgsign*)",
        "Bash(git *gpgSign*)"
      ]
    }
  }
}
