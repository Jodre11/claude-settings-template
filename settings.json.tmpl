{
  "awsAuthRefresh": "__AWS_SSO_REFRESH_PATH__",
  "env": {
    "API_TIMEOUT_MS": "1200000",
    "AWS_PROFILE": "__AWS_PROFILE__",
    "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "SEARXNG_URL": "__SEARXNG_URL__"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(playwright-cli *)",
      "Bash(read-only commands)",
      "Bash(jb:*)",
      "Bash(ruff:*)",
      "Bash(nbqa:*)",
      "Bash(trivy:*)",
      "Bash(eslint:*)",
      "Bash(biome:*)",
      "Bash(housekeeper-freshness:*)",
      "Bash(*/node_modules/.bin/eslint *)",
      "Bash(*/node_modules/.bin/biome *)",
      "Bash(terraform fmt *)",
      "Bash(mkdir -p /tmp/claude-*)",
      "Bash(cat /tmp/claude-*)",
      "Bash(cat * > /tmp/claude-*)",
      "Bash(rm /tmp/claude-*)",
      "Bash(rm -f /tmp/claude-*)",
      "Bash(rm -rf /tmp/claude-*)",
      "Write(//tmp/claude-**)",
      "Edit(//tmp/claude-**)",
      "Read",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(brew info *)",
      "Bash(whisper-cli *)",
      "Bash(dotnet build *)",
      "Bash(dotnet add *)",
      "Bash(dotnet run *)",
      "Bash(curl -fsSL *)",
      "Bash(curl -s *)",
      "Bash(curl -sS *)",
      "Bash(dotnet list *)",
      "Bash(dotnet nuget *)",
      "Bash(dotnet package *)",
      "Bash(cargo init *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(jq *)",
      "Bash(cp * /tmp/claude-*)",
      "Bash(cp * .)",
      "Bash(cp * ./*)",
      "Bash(command claude *)",
      "Bash(~/.claude/scripts/set-session-topic.sh:*)",
      "Bash(~/.claude/scripts/handover-path.sh:*)",
      "Read(~/.claude/commands/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/agents/**)",
      "Read(~/.claude/plugins/**)",
      "Bash(chmod +x ~/.claude/hooks/*)",
      "Bash(chmod +x ~/.claude/scripts/*)",
      "Bash(python3 *.py)",
      "Bash(python3 -m *)",
      "Bash(tmux *)",
      "Bash(aws sso *)",
      "Bash(aws sts *)",
      "Bash(aws s3 ls *)",
      "Bash(aws s3 cp *)",
      "Bash(aws secretsmanager get-secret-value *)",
      "Bash(aws bedrock-runtime *)",
      "Bash(aws ecr get-login-password *)",
      "Bash(md2clip *)",
      "Bash(xxd *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(file *)",
      "Bash(open *)",
      "Bash(printf *)"
    ],
    "deny": [
      "Read(**/secrets/**)",
      "Read(**/.strongbox-keyid)",
      "Read(~/.strongbox_keyring)",
      "Read(**/*.secret)",
      "Bash(cat **/secrets/**)",
      "Bash(strings **/secrets/**)",
      "Bash(xxd **/secrets/**)",
      "Bash(*strongbox_keyring*)"
    ]
  },
  "sandbox": {
    "allowedDomains": [
      "api.nuget.org",
      "registry.npmjs.org",
      "pypi.org",
      "api.github.com",
      "registry-1.docker.io",
      "auth.docker.io"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.sh",
            "timeout": 5,
            "statusMessage": "Initialising session..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handover-detect.sh",
            "timeout": 5,
            "statusMessage": "Checking for handover..."
          },
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_TOPIC_GUESS\" ] && [ -n \"$TMUX\" ] && [ -z \"$CLAUDE_CODE_USE_BEDROCK\" ] && tmux set status-style bg=colour218,fg=black; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-topic.sh",
            "timeout": 5,
            "statusMessage": "Guessing session topic..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-topic-provisional.sh",
            "timeout": 5,
            "statusMessage": "Setting provisional topic..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-prompt-guard.sh",
            "timeout": 5,
            "statusMessage": "Screening prompt for secrets..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_TOPIC_GUESS\" ] && [ -n \"$TMUX\" ] && tmux set -u status-style; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-permissions.sh",
            "timeout": 5,
            "statusMessage": "Checking allowed commands..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking Bash rules..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-bash-guard.sh",
            "timeout": 5,
            "statusMessage": "Screening for secrets..."
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-path-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking secret paths..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-mode-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking agent mode..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-write-permissions.sh",
            "timeout": 5,
            "statusMessage": "Checking write permissions..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/temp-path-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking temp path..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-output-scrubber.sh",
            "timeout": 5,
            "statusMessage": "Scrubbing tool output for secrets..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/api-failure-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/api-failure-log.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": false,
    "roslyn-lsp@jodre11-plugins": true,
    "claude-security@claude-plugins-official": true
  },
  "language": "English UK",
  "showThinkingSummaries": true,
  "teammateMode": "in-process"
}
